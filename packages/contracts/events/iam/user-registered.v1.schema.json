{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rcp/events/iam/user-registered.v1.schema.json",
  "title": "iam.user.registered v1 (data payload)",
  "type": "object",
  "required": ["user_id", "email", "full_name", "roles", "is_active", "updated_at"],
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email" },
    "full_name": { "type": "string" },
    "phone": { "type": ["string", "null"] },
    "roles": { "type": "array", "items": { "type": "string" } },
    "is_active": { "type": "boolean" },
    "updated_at": { "type": "string", "format": "date-time", "description": "Source-of-truth timestamp; consumers reject older updates" }
  }
}
