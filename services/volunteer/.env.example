# Supabase Connection
DATABASE_URL=postgresql+psycopg2://<db-user>:<db-password>@<your-project>.pooler.supabase.com:5432/postgres?sslmode=require

# Stop automatic table creation (Managed by Alembic migrations now)
AUTO_CREATE_TABLES=false

# Local RabbitMQ & Keys (Do not change these for local dev)
RABBITMQ_URL=amqp://rcp:rcp_local_pw@localhost:5672/rcp
JWT_PRIVATE_KEY_PATH=../../infra/compose/secrets/jwt_dev_key.pem