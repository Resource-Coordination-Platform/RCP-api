# svc_analytics: owns schema_analytics; projections fed by logistics events
DATABASE_URL=postgresql+psycopg2://<db-user>:<db-password>@<your-project>.pooler.supabase.com:5432/postgres?sslmode=require

RABBITMQ_URL=amqp://rcp:rcp_local_pw@localhost:5672/rcp

# JWT verification (issued by IAM; verified locally via cached JWKS)
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
